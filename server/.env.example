# Supabase project URL used by the server.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only credential. Never copy this value into the iOS client.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Beijing-region Model Studio credential and workspace-specific endpoint.
# The API key, endpoint region, and model availability must belong to the same region.
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-omni-plus

# Reference timezone used to resolve relative dates such as “昨天” and “上周五”.
BUSINESS_TIMEZONE=Asia/Shanghai

# Canonical API port for local development and the default container runtime.
# Hosting platforms may override this variable at runtime.
PORT=8000
